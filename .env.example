# Скопируйте в .env и заполните реальными значениями. .env не коммитится.

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-50-character-secret
DEBUG=False
ALLOWED_HOSTS=punkt.example.com
CSRF_TRUSTED_ORIGINS=https://punkt.example.com
BASE_URL=https://punkt.example.com
TIME_ZONE=Asia/Novosibirsk

# --- База данных ------------------------------------------------------------
# POSTGRES_* используются контейнером db; DATABASE_URL должен ссылаться на те же значения.
POSTGRES_DB=punkt
POSTGRES_USER=punkt
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://punkt:change-me-strong-password@db:5432/punkt

# --- Telegram-бот -----------------------------------------------------------
BOT_TOKEN=123456:your-telegram-bot-token-from-botfather

# --- Файлы и копии ------------------------------------------------------------
MEDIA_ROOT=/app/media
BACKUP_PATH=/app/backups

# --- Caddy (домен для TLS) ---------------------------------------------------
BASE_DOMAIN=punkt.example.com
